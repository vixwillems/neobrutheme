{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1200px"
    },
    "color": {
      "custom": true,
      "customDuotone": false,
      "customGradient": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "palette": [
        {
          "slug": "background",
          "color": "#FFFFFF",
          "name": "Background"
        },
        {
          "slug": "foreground",
          "color": "#000000",
          "name": "Foreground"
        },
        {
          "slug": "accent-red",
          "color": "#FF5C5C",
          "name": "Accent Red"
        },
        {
          "slug": "secondary-yellow",
          "color": "#FFDE59",
          "name": "Secondary Yellow"
        },
        {
          "slug": "accent-cyan",
          "color": "#5CE1E6",
          "name": "Accent Cyan"
        },
        {
          "slug": "white",
          "color": "#FFFFFF",
          "name": "White"
        }
      ]
    },
    "typography": {
      "customFontSize": true,
      "dropCap": false,
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "textDecoration": true,
      "textTransform": true,
      "fluid": false,
      "fontFamilies": [
        {
          "slug": "space-grotesk",
          "name": "Space Grotesk",
          "fontFamily": "'Space Grotesk', sans-serif",
          "fontFace": [
            {
              "fontFamily": "Space Grotesk",
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["assets/fonts/space-grotesk-400.woff2"]
            },
            {
              "fontFamily": "Space Grotesk",
              "fontWeight": "500",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["assets/fonts/space-grotesk-500.woff2"]
            },
            {
              "fontFamily": "Space Grotesk",
              "fontWeight": "700",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["assets/fonts/space-grotesk-700.woff2"]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "size": "0.75rem",
          "name": "Small",
          "fluid": false
        },
        {
          "slug": "medium",
          "size": "1rem",
          "name": "Medium",
          "fluid": false
        },
        {
          "slug": "large",
          "size": "1.25rem",
          "name": "Large",
          "fluid": false
        },
        {
          "slug": "x-large",
          "size": "1.5rem",
          "name": "Extra Large",
          "fluid": false
        },
        {
          "slug": "xx-large",
          "size": "2.25rem",
          "name": "Huge",
          "fluid": false
        },
        {
          "slug": "xxx-large",
          "size": "3rem",
          "name": "Giant",
          "fluid": false
        }
      ]
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "blockGap": true,
      "customSpacingSize": true,
      "defaultSpacingSizes": false,
      "units": ["px", "em", "rem", "vh", "vw"],
      "spacingSizes": [
        { "slug": "10", "size": "0.25rem", "name": "X-Small" },
        { "slug": "20", "size": "0.5rem", "name": "Small" },
        { "slug": "30", "size": "0.75rem", "name": "Medium Small" },
        { "slug": "40", "size": "1rem", "name": "Medium" },
        { "slug": "50", "size": "1.5rem", "name": "Medium Large" },
        { "slug": "60", "size": "2rem", "name": "Large" },
        { "slug": "70", "size": "3rem", "name": "X-Large" },
        { "slug": "80", "size": "4rem", "name": "XX-Large" },
        { "slug": "90", "size": "6rem", "name": "XXX-Large" }
      ]
    },
    "border": {
      "color": true,
      "radius": false,
      "style": true,
      "width": true
    },
    "custom": {
      "borderShadow": "8px 8px 0 0 var(--wp--preset--color--foreground)",
      "borderShadowSm": "4px 4px 0 0 var(--wp--preset--color--foreground)",
      "borderShadowLg": "12px 12px 0 0 var(--wp--preset--color--foreground)"
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": false
        },
        "typography": {
          "fontFamily": true,
          "fontSize": true,
          "lineHeight": false
        }
      },
      "core/heading": {
        "typography": {
          "fontFamily": true,
          "lineHeight": false
        }
      },
      "core/paragraph": {
        "typography": {
          "fontFamily": true,
          "lineHeight": false
        }
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--foreground)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--space-grotesk)",
      "fontWeight": "400",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--space-grotesk)",
          "fontWeight": "900",
          "textTransform": "uppercase",
          "letterSpacing": "-0.05em"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--foreground)"
        },
        "typography": {
          "textDecoration": "none"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--accent-red)"
          }
        }
      },
      "button": {
        "border": {
          "color": "var(--wp--preset--color--foreground)",
          "style": "solid",
          "width": "4px"
        },
        "color": {
          "background": "var(--wp--preset--color--background)",
          "text": "var(--wp--preset--color--foreground)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--space-grotesk)",
          "fontWeight": "700",
          "textTransform": "uppercase",
          "letterSpacing": "0.06em"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--accent-red)",
            "text": "var(--wp--preset--color--white)"
          }
        }
      },
      "caption": {
        "color": {
          "text": "var(--wp--preset--color--foreground)"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        }
      }
    }
  }
}
