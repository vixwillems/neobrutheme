{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "neobrutheme/marquee",
  "title": "Marquee",
  "category": "neobrutheme",
  "icon": "slides",
  "description": "Scrolling text marquee.",
  "attributes": {
    "text": { "type": "string", "default": "" },
    "speed": { "type": "string", "default": "medium" },
    "color": { "type": "string", "default": "yellow" }
  },
  "supports": {
    "html": false
  },
  "editorScript": "file:../../assets/js/blocks.js",
  "render": "file:./render.php"
}
