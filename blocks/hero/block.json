{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "neobrutheme/hero",
  "title": "Hero",
  "category": "neobrutheme",
  "icon": "superhero",
  "description": "Full-width hero section with heading, subheading, and composition panel.",
  "attributes": {
    "heading": { "type": "string", "default": "" },
    "subheading": { "type": "string", "default": "" },
    "bgColor": { "type": "string", "default": "cyan" },
    "showComposition": { "type": "boolean", "default": true }
  },
  "supports": {
    "html": false
  },
  "editorScript": "file:../../assets/js/blocks.js",
  "render": "file:./render.php"
}
