              "key": "field_features",
              "label": "Features",
              "name": "features",
              "type": "repeater",
              "layout": "block",
              "button_label": "Add Feature",
              "sub_fields": [
                { "key": "field_feature_title", "label": "Title", "name": "title", "type": "text" },
                { "key": "field_feature_desc", "label": "Description", "name": "description", "type": "text" },
                {
                  "key": "field_feature_color",
                  "label": "Accent Color",
                  "name": "color",
                  "type": "select",
                  "choices": { "cyan": "Cyan", "red": "Red", "yellow": "Yellow" },
                  "default_value": "cyan"
