              "type": "repeater",
              "layout": "block",
              "button_label": "Add Testimonial",
              "sub_fields": [
                { "key": "field_test_quote", "label": "Quote", "name": "quote", "type": "textarea", "rows": 3 },
                { "key": "field_test_author", "label": "Author", "name": "author", "type": "text" },
                { "key": "field_test_role", "label": "Role", "name": "role", "type": "text" }
              ]
            }
          ]
        },
        {
          "key": "layout_cta",
          "name": "cta",
