{
  "key": "group_options_homepage",
  "title": "Homepage Layout",
  "fields": [
    {
      "key": "field_page_layouts",
      "label": "Page Layouts",
      "name": "page_layouts",
      "type": "flexible_content",
      "button_label": "Add Layout",
      "layouts": [
        {
          "key": "layout_hero",
          "name": "hero",
          "title": "Hero",
          "display": "block",
          "sub_fields": [
            { "key": "field_hero_heading", "label": "Heading", "name": "heading", "type": "text" },
            { "key": "field_hero_subheading", "label": "Subheading", "name": "subheading", "type": "textarea", "rows": 2 },
            {
              "key": "field_hero_bg_color",
              "label": "Background Color",
              "name": "bg_color",
              "type": "select",
              "choices": { "red": "Red", "yellow": "Yellow", "cyan": "Cyan", "white": "White" },
              "default_value": "cyan"
            },
            {
              "key": "field_hero_show_composition",
              "label": "Show Composition Panel",
              "name": "show_composition",
              "type": "true_false",
              "default_value": 1,
              "ui": 1
            }
          ]
        },
        {
          "key": "layout_marquee",
          "name": "marquee",
          "title": "Marquee",
          "display": "block",
          "sub_fields": [
            { "key": "field_marquee_text", "label": "Text", "name": "text", "type": "text" },
            {
              "key": "field_marquee_speed",
              "label": "Speed",
              "name": "speed",
              "type": "select",
              "choices": { "slow": "Slow", "medium": "Medium", "fast": "Fast" },
              "default_value": "medium"
            },
            {
              "key": "field_marquee_color",
              "label": "Color",
              "name": "color",
              "type": "select",
              "choices": { "red": "Red", "cyan": "Cyan", "yellow": "Yellow" },
              "default_value": "yellow"
            }
          ]
        },
