                { "key": "field_stat_number", "label": "Number", "name": "number", "type": "number" },
                { "key": "field_stat_label", "label": "Label", "name": "label", "type": "text" },
                {
                  "key": "field_stat_color",
                  "label": "Color",
                  "name": "color",
                  "type": "select",
                  "choices": { "red": "Red", "yellow": "Yellow", "cyan": "Cyan" },
                  "default_value": "yellow"
